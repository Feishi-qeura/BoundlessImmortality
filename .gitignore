# Unreal Engine generated output
/Binaries/
/DerivedDataCache/
/Intermediate/
/Saved/
**/Saved/
**/Binaries/
**/DerivedDataCache/
**/Intermediate/

# Generated IDE files and local editor state
/.vs/
/.idea/
/.superpowers/
/*.sln
/*.slnx

# Python bytecode and local caches
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build, analysis, and temporary output
*.obj
*.o
*.lib
*.exp
*.ilk
*.pdb
*.rsp
*.sarif
*.log
*.tmp
*.temp

# Backup copies are not source-of-truth project files
**/backup/
**/backups/
**/Backup/
**/Backups/

# Local secrets and signing material
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Local UI validation sessions, databases, and duplicate review snapshots
/specs/boundless-ink-ui/**/engine-user*/
/specs/boundless-ink-ui/**/engine-qa-service*/
/specs/boundless-ink-ui/**/engine-backup/
/specs/boundless-ink-ui/**/model/review/*snapshot*/
/specs/boundless-ink-ui/**/logic-integration/actual-ui-entry-*/
/specs/boundless-ink-ui/**/logic-integration/default-root-pie-*/
/specs/boundless-ink-ui/**/logic-integration/service-pie-*/
/specs/boundless-ink-ui/**/logic-integration/stage-pie-*/
/specs/boundless-ink-ui/**/logic-integration/native-tests-*-report/
/specs/boundless-ink-ui/**/logic-integration/service-data-*/
/specs/boundless-ink-ui/**/logic-integration/avatar-tls-fixture-*/
/specs/boundless-ink-ui/**/logic-integration/canonical-source-stage/
/specs/boundless-ink-ui/**/logic-integration/remaining-source-stage/
/specs/boundless-ink-ui/**/*.sqlite3*
