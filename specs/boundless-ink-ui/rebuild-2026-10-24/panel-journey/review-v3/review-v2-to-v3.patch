+        B->SetIsEnabled(M.bKnown&&!bRequestPending);
+        MilestoneButtons.Add(B);
+    }
+
+    const auto* Selected=Milestones.FindByPredicate([this](const auto& M){return M.Milestone==SelectedMilestone;});
+    const bool bHasSubject=!ExpectedServiceDay.IsEmpty()&&!ServerMonth.IsEmpty();
