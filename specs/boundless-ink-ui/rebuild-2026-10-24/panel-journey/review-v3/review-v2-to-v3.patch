+    MilestoneList->ClearChildren();
+    MilestoneButtons.Reset();
+    for (const auto& M : Milestones)
+    {
+        auto* B=WidgetTree->ConstructWidget<UInkJourneyMilestoneButton>(UInkJourneyMilestoneButton::StaticClass(),*FString::Printf(TEXT("Milestone_%d"),M.Milestone));
+        const FText Caption=M.bKnown?FText::Format(NSLOCTEXT("Journey","MilestoneLabel","累计 {0} 天"),FText::AsNumber(M.Milestone)):FText::FromString(TEXT("奖励条件待同步"));
