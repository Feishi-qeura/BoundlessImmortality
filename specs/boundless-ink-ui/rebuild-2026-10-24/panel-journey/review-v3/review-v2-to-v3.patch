+void UInkJourneyMonthlySignInPageWidget::HandleMilestoneSelected(int32 M)
+{
+    if (bRequestPending) return;
+    if (SelectedMilestone != M)
+    {
+        SelectedMilestone=M;
+        ClearCapturedConfirmation();
+    }
+    RefreshMilestones();
+}
+void UInkJourneyMonthlySignInPageWidget::HandleConfirmClaim()
+{
+    if (bRequestPending) return;
+
+    if (!bConfirmationOpen)
+    {
+        if (ExpectedServiceDay.IsEmpty() || ServerMonth.IsEmpty()) return;
+        const auto* Selected=Milestones.FindByPredicate([this](const auto& M){return M.Milestone==SelectedMilestone;});
+        if (!Selected || !Selected->bKnown || !Selected->bEligible || Selected->bClaimed) return;
+
+        CapturedServiceDay=ExpectedServiceDay;
+        CapturedMonth=ServerMonth;
+        CapturedMilestone=SelectedMilestone;
+        bConfirmationOpen=true;
+        RefreshMilestones();
+        return;
+    }
+
+    const auto* Captured=Milestones.FindByPredicate([this](const auto& M){return M.Milestone==CapturedMilestone;});
+    const bool bIdentityStillMatches=CapturedServiceDay==ExpectedServiceDay&&CapturedMonth==ServerMonth&&CapturedMilestone==SelectedMilestone;
+    if (!bIdentityStillMatches || !Captured || !Captured->bKnown || !Captured->bEligible || Captured->bClaimed)
+    {
+        ClearCapturedConfirmation();
+        RefreshMilestones();
+        return;
+    }
+
+    const FString RequestDay=CapturedServiceDay;
+    const FString RequestMonth=CapturedMonth;
+    const int32 RequestMilestone=CapturedMilestone;
+    bConfirmationOpen=false;
+    bRequestPending=true;
+    RefreshMilestones();
+    OnMilestoneClaimRequested.Broadcast(RequestDay,RequestMonth,RequestMilestone);
+}
 
