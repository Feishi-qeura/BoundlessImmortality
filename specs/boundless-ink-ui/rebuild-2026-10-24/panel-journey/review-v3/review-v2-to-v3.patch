+    if (ConfirmButton)
+    {
+        ConfirmButton->SetIsEnabled(bCan||bConfirmationOpen);
+        ConfirmText->SetText(bRequestPending?FText::FromString(TEXT("提交中")):bConfirmationOpen?FText::FromString(TEXT("确认领取")):bCan?FText::FromString(TEXT("领取此档奖励")):FText::FromString(TEXT("选择可领取奖励")));
+    }
+}
